# Mesmo projeto Supabase Pro usado pelo vigia (etl/.env) — pode copiar os
# mesmos valores de lá. Painel > Settings > API.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role key (o painel só faz leitura de dados de negócio, usa essa
# chave pra não depender de login pra ISSO — a autenticação de quem acessa
# o painel é outra coisa, ver as duas variáveis NEXT_PUBLIC_ abaixo).
# NUNCA prefixar com NEXT_PUBLIC_, senão vai pro navegador.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-chave-aqui

# Login do painel (Lote 14, 2026-08-30) — Supabase Auth. Estas DUAS
# variáveis são públicas de propósito (prefixo NEXT_PUBLIC_ = vão pro
# navegador) e ficam protegidas pelo próprio Supabase Auth + Row Level
# Security, então não tem problema expor. Pegue em Painel > Settings > API:
# - NEXT_PUBLIC_SUPABASE_URL = igual ao SUPABASE_URL acima
# - NEXT_PUBLIC_SUPABASE_ANON_KEY = a chave "anon public" (NÃO a service_role)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-chave-anon-aqui
